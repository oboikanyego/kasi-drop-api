# Local demo runs without a database; data resets on restart
DEMO_MODE=true
PORT=10000
CLIENT_URL=http://localhost:4200
# Required for persistent production mode
MONGODB_URI=
MONGODB_DB_NAME=kasidrop
JWT_SECRET=
# Optional sandbox payment (never insert secrets in the client)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PUBLIC_API_URL=http://localhost:10000
# Optional Claude API (rate-limited)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
