# Local demo runs without a database; data resets on restart
DEMO_MODE=true
PORT=10000
CLIENT_URL=http://localhost:4200
# Persistent mode: supply BOTH values, then set DEMO_MODE=false
# Never commit real Atlas connection credentials.
MONGODB_URI=
MONGODB_DB_NAME=kasidrop
JWT_SECRET=
# On every start with DEMO_MODE=false, missing catalogue products are upserted.
# Optional CLI-only admin provisioning (never a shared public demo account):
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional persistent test accounts (1 admin + 3 customers) and 5 sample orders.
# Leave disabled outside controlled demo environments. No hardcoded passwords.
SEED_DEMO_USERS=false
SEED_DEMO_ADMIN_PASSWORD=
SEED_DEMO_CUSTOMER_PASSWORD=
# Optional sandbox payment (never insert secrets in the client)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PUBLIC_API_URL=http://localhost:10000
# Optional Claude API (rate-limited)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
